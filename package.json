{
  "name": "flow-my-day",
  "version": "1.2.2",
  "description": "Personal productivity CLI to track completed tasks, later tasks, and technical debt.",
  "type": "module",
  "bin": {
    "flow": "./bin/flow.js"
  },
  "main": "src/cli.js",
  "scripts": {
    "start": "node ./bin/flow.js",
    "dev": "node ./bin/flow.js",
    "check": "node --check ./src/cli.js",
    "help": "node ./bin/flow.js --help",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\""
  },
  "keywords": [
    "cli",
    "productivity",
    "tasks",
    "technical-debt",
    "nodejs"
  ],
  "author": "Duvan Felipe Correa Ardila <duvancorrea96@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DuvanCorrea/Flow-My-Day.git"
  },
  "homepage": "https://github.com/DuvanCorrea/Flow-My-Day#readme",
  "bugs": {
    "url": "https://github.com/DuvanCorrea/Flow-My-Day/issues"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "dayjs": "^1.11.18"
  }
}